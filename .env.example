# Django
SECRET_KEY=django-insecure-replace-me
DEBUG=True
ALLOWED_HOSTS=*

# Database — local SQLite by default (no Docker / Postgres required)
USE_SQLITE=True
DB_NAME=voiceagent
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=sqlite:///db.sqlite3

# Redis (optional locally; Celery can run eager)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Retell AI (required for live agents / sync)
retell_api_key=your_retell_api_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google-calendar/callback/

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# LangSmith
LANGSMITH_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=voice-agent-platform

# Celery
CELERY_TASK_ALWAYS_EAGER=True

# Services — use localhost, or your public URL when testing Retell webhooks
DJANGO_BASE_URL=http://localhost:8000
FASTAPI_BASE_URL=

# Twilio (legacy optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_APP_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Groq
GROQ_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Email (booking confirmation)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Gemini
GEMINI_API_KEY=
